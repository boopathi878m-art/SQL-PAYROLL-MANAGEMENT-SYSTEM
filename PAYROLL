  --- stored procedure --
-- 1. Retrieve employees whose salary is above ₹75,000.
delimiter //
 create procedure highsalary75k (in A decimal(10,2) )
 begin
 select e.EmployeeID, e.Name, s.TotalPay
 from employee e
 inner join salarystructure s
 on e.EmployeeID = s.EmployeeID
 where s.TotalPay < A;
 end //
delimiter ;
  call highsalary75k (75000);
 
-- 2. Find employees who have taken leave in April 2025 ---
delimiter //
create procedure leave25(in startdate date,in end_date date)
begin
SELECT e.EmployeeID, e.Name, a.Date, a.LeaveType 
FROM Employee e
JOIN Attendance a ON e.EmployeeID = a.EmployeeID
WHERE a.Status = "Leave" AND a.date between startdate and end_date;
end //
delimiter ;
call leave25( "2025-04-01 ","2025-04-30");

-- 3.Retrieve total overtime hours logged by all employees.
delimiter //
create procedure totallovertime()
begin
select sum(OvertimeHours) from attendance;

end //
delimiter ;
call totallovertime();


-- 4.Find employees who have the highest tax percentage.
delimiter //
create procedure highesttax()
begin
select e.name ,t.EmployeeID,t.TaxPercentage from employee e
inner join tax t
on e.EmployeeID = t.EmployeeID
order by t.TaxPercentage desc
limit 1;
end //
delimiter ;
call   highesttax();

-- 5.List all departments along with the number of employees in each department.
delimiter //
create view countemployee as
select d.DepartmentID, d.DepartmentName, count(e.EmployeeID) as number_of_employee from Department d
left join employee e
on d.DepartmentID = e.DepartmentID 
group by d.DepartmentName,d.DepartmentID;


-- 6.Calculate the average salary of employees across all departments.

create view avg_salary as
select avg(TotalPay) from SalaryStructure ;

-- 7.Retrieve employees who have worked overtime and their total work hours.
delimiter //
create procedure overtime_employees(in A decimal(4,2))
begin
select  e.name, e.EmployeeID, sum(a.OvertimeHours) from employee e
join attendance a
on e.EmployeeID = a.EmployeeID
where a.OvertimeHours > A
group by e.name, e.EmployeeID;
end //
delimiter ;
call overtime_employees(0);


-- 8. Find employees who have been absent at least once in April 2025
delimiter //
create procedure absent(in A date,in B date)
begin
select e.name,e.EmployeeID,a.Status from employee e 
join attendance a
on e.EmployeeID = a. EmployeeID
where a.status = "absent" and a.date between A and B;
end //
delimiter ;
call absent ("2025-04-01","2025-04-30");

-- 9. Identify employees with a salary below ₹50,000
delimiter //
create procedure below_salay_50k(in A int)
begin
select e.name,e.EmployeeID,s.TotalPay from employee e
join salarystructure s
on e.EmployeeID = s. EmployeeID
where s.TotalPay < A;
end //
delimiter ;
call  below_salay_50k(50000);
 
-- 10.Find employees who have never taken leave. 
DELIMITER //

CREATE PROCEDURE never_take_leave()
BEGIN
    SELECT e.EmployeeID, e.Name, a.status
    FROM Employee e
    LEFT JOIN Attendance a 
    ON e.EmployeeID = a.EmployeeID 
    WHERE a.status NOT IN ('Leave', 'Absent', 'Half-Day');
END //

DELIMITER ;
call never_take_leave();
